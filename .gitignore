# Keep data documentation; exclude local data artifacts.
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md
data/embeddings/*
!data/embeddings/README.md

# Local generated corpora and vector artifacts (keep documentation).
/data_local/processed/**
!/data_local/processed/**/
!/data_local/processed/**/README.md
/data_local/embeddings/**
!/data_local/embeddings/**/
!/data_local/embeddings/**/README.md
/data_local/.prepare-retrieval-*/

# Atomic evaluation output staging.
/evaluation/results/**/*.tmp

# Mentor-demo downloads and generated outputs (bundled demo_data stays tracked).
/.model_cache/
/outputs/
/sample_output*.json
